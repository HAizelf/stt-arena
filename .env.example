# Candidate STT models are streamed through LiveKit Inference (one key, many providers).
# Create a project at https://cloud.livekit.io and copy its URL / API key / secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Golden drafts: ElevenLabs Scribe (batch speech-to-text). Only needed for draft_golden.py.
ELEVENLABS_API_KEY=

# LLM judge (judge.py run). Only needed if you use the built-in judge.
ANTHROPIC_API_KEY=
